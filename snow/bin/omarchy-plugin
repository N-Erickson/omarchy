#!/bin/bash
# Omarchy plugin system bridge for Sway
# Since Quickshell IPC is not available, plugins are managed via git

PLUGINS_DIR="$HOME/.config/omarchy/plugins"
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"

case "${1:-help}" in
    list)
        echo "Omarchy Plugins (Sway bridge)"
        echo "=============================="
        if [ -d "$PLUGINS_DIR" ]; then
            for d in "$PLUGINS_DIR"/*/; do
                [ -d "$d" ] || continue
                name=$(basename "$d")
                desc=""
                [ -f "$d/plugin.toml" ] && desc=$(grep "^description" "$d/plugin.toml" | sed 's/.*= *"\(.*\)"/\1/')
                printf "  %-20s %s\n" "$name" "$desc"
            done
        else
            echo "  No plugins installed"
        fi
        ;;
    install|add)
        shift
        url="$1"
        [ -z "$url" ] && { echo "Usage: omarchy plugin install <git-url>"; exit 1; }
        name=$(basename "$url" .git)
        mkdir -p "$PLUGINS_DIR"
        if [ -d "$PLUGINS_DIR/$name" ]; then
            echo "Plugin '$name' already installed"
        else
            git clone "$url" "$PLUGINS_DIR/$name" 2>&1
            echo "Plugin '$name' installed"
            # Run install hook if present
            [ -x "$PLUGINS_DIR/$name/install.sh" ] && "$PLUGINS_DIR/$name/install.sh"
        fi
        ;;
    remove|rm)
        shift
        name="$1"
        [ -z "$name" ] && { echo "Usage: omarchy plugin remove <name>"; exit 1; }
        if [ -d "$PLUGINS_DIR/$name" ]; then
            # Run uninstall hook if present
            [ -x "$PLUGINS_DIR/$name/uninstall.sh" ] && "$PLUGINS_DIR/$name/uninstall.sh"
            rm -rf "$PLUGINS_DIR/$name"
            echo "Plugin '$name' removed"
        else
            echo "Plugin '$name' not found"
        fi
        ;;
    update)
        shift
        if [ -n "$1" ]; then
            name="$1"
            [ -d "$PLUGINS_DIR/$name" ] || { echo "Plugin '$name' not found"; exit 1; }
            (cd "$PLUGINS_DIR/$name" && git pull 2>&1)
        else
            for d in "$PLUGINS_DIR"/*/; do
                [ -d "$d/.git" ] || continue
                name=$(basename "$d")
                echo "Updating $name..."
                (cd "$d" && git pull 2>&1)
            done
        fi
        ;;
    catalog)
        echo "Omarchy Plugin Catalog"
        echo "======================"
        echo ""
        echo "Browse community plugins at:"
        echo "  https://github.com/topics/omarchy-plugin"
        echo ""
        echo "Install with:"
        echo "  omarchy plugin install <git-url>"
        ;;
    help|--help|-h)
        echo "Usage: omarchy plugin <command>"
        echo ""
        echo "Commands:"
        echo "  list              List installed plugins"
        echo "  install <url>     Install a plugin from git"
        echo "  remove <name>     Remove an installed plugin"
        echo "  update [name]     Update plugins"
        echo "  catalog           Browse available plugins"
        ;;
    *)
        echo "Unknown plugin command: $1"
        echo "Run 'omarchy plugin help' for usage"
        exit 1
        ;;
esac
