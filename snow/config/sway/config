# ╔═══════════════════════════════════════════════════╗
# ║              Omarchy Snow 4.0.0                   ║
# ║       Samsung Chromebook XE303C12 · Sway          ║
# ╚═══════════════════════════════════════════════════╝

# ── Display ───────────────────────────────────────────
output * bg ~/.local/state/omarchy/current/background fill
output LVDS-1 resolution 1366x768

# ── Input ─────────────────────────────────────────────
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    click_method button_areas
    scroll_factor 0.4
}
input type:keyboard {
    xkb_layout us
    repeat_rate 40
    repeat_delay 250
}

# ── Tokyo Night Palette ──────────────────────────────
set $bg        #1a1b26
set $bg_dark   #13141c
set $bg_light  #24283b
set $fg        #a9b1d6
set $fg_bright #c0caf5
set $fg_dark   #565f89
set $accent    #7aa2f7
set $red       #f7768e
set $green     #9ece6a
set $yellow    #e0af68
set $cyan      #449dab
set $magenta   #bb9af7
set $selection #292e42
set $muted     #414868

# ── Look & Feel ──────────────────────────────────────
default_border pixel 2
gaps inner 5
gaps outer 10
font pango:JetBrainsMono Nerd Font 8

client.focused          #33ccff $bg $fg_bright #00ff99 #33ccff
client.focused_inactive $muted  $bg $fg        $muted  $muted
client.unfocused        #595959 $bg $fg_dark   #595959 #595959
client.urgent           $red    $bg $fg_bright $red    $red

# ── Cursor ────────────────────────────────────────────
seat * hide_cursor when-typing enable
seat * hide_cursor 3000

# ── Mod Key ──────────────────────────────────────────
set $mod Mod4

# ╔═══════════════════════════════════════════════════╗
# ║                  APPLICATIONS                     ║
# ╚═══════════════════════════════════════════════════╝

bindsym $mod+Return exec foot
bindsym $mod+Shift+Return exec firefox
bindsym $mod+Shift+f exec nautilus
bindsym $mod+Shift+t exec foot -T "btop" -e btop
bindsym $mod+Alt+Return exec foot -e tmux
bindsym $mod+Shift+a exec foot -T "AI Chat" -e aichat
bindsym $mod+Shift+b exec firefox
bindsym $mod+Shift+n exec foot -T "Editor" -e nano
bindsym $mod+Ctrl+b exec foot -T "Bluetooth" -e bluetoothctl
bindsym $mod+Shift+BackSpace exec swaymsg gaps inner current toggle 5, gaps outer current toggle 10
bindsym Alt+Tab focus next
bindsym Alt+Shift+Tab focus prev
bindsym $mod+Ctrl+Escape exec ~/.local/bin/omarchy-system-menu

# ╔═══════════════════════════════════════════════════╗
# ║                 MENUS & LAUNCHERS                 ║
# ╚═══════════════════════════════════════════════════╝

bindsym $mod+space exec fuzzel
bindsym $mod+d exec fuzzel
bindsym $mod+m exec ~/.local/bin/omarchy-menu
bindsym $mod+Escape exec ~/.local/bin/omarchy-power-menu
bindsym $mod+Ctrl+t exec ~/.local/bin/omarchy-theme-selector
bindsym $mod+Ctrl+a exec ~/.local/bin/omarchy-appearance-menu
bindsym $mod+Ctrl+s exec ~/.local/bin/omarchy-settings-menu
bindsym $mod+Ctrl+n exec foot -T "Network" nmtui
bindsym $mod+slash exec ~/.local/bin/omarchy-keybindings

# ╔═══════════════════════════════════════════════════╗
# ║                 WINDOW MANAGEMENT                 ║
# ╚═══════════════════════════════════════════════════╝

bindsym $mod+q kill
bindsym $mod+w kill
bindsym $mod+f fullscreen
bindsym $mod+Shift+v floating toggle
bindsym $mod+v exec foot -T alsamixer -e alsamixer

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+b splith
bindsym $mod+n splitv
bindsym $mod+s layout stacking
bindsym $mod+e layout toggle split
default_orientation horizontal

mode "resize" {
    bindsym h resize shrink width 10px
    bindsym j resize grow height 10px
    bindsym k resize shrink height 10px
    bindsym l resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ╔═══════════════════════════════════════════════════╗
# ║                  WORKSPACES                       ║
# ╚═══════════════════════════════════════════════════╝

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output

# ── Scratchpad ────────────────────────────────────────
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# ╔═══════════════════════════════════════════════════╗
# ║               MEDIA / HARDWARE KEYS               ║
# ╚═══════════════════════════════════════════════════╝

bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk "{printf \"%.0f\", \$2 * 100}" > /run/user/1001/wob.sock
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk "{printf \"%.0f\", \$2 * 100}" > /run/user/1001/wob.sock
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# ╔═══════════════════════════════════════════════════╗
# ║                 SCREENSHOTS                       ║
# ╚═══════════════════════════════════════════════════╝

bindsym Print exec grim ~/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym $mod+Shift+s exec grim -g "$(slurp)" ~/screenshot-$(date +%Y%m%d-%H%M%S).png

# ╔═══════════════════════════════════════════════════╗
# ║                  LOCK / SESSION                   ║
# ╚═══════════════════════════════════════════════════╝

bindsym $mod+Ctrl+l exec swaylock
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning -m "Exit Omarchy?" -B "Yes" "swaymsg exit"
bindsym $mod+Shift+space bar mode toggle

floating_modifier $mod normal

# ╔═══════════════════════════════════════════════════╗
# ║                  WINDOW RULES                     ║
# ╚═══════════════════════════════════════════════════╝

for_window [window_role="dialog"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="org.gnome.Nautilus"] floating enable
for_window [title="btop"] floating enable, resize set 900 550
for_window [title="Calendar"] floating enable
for_window [title="About Omarchy"] floating enable
for_window [title="Power"] floating enable
for_window [title="Keybindings"] floating enable, resize set 700 600
for_window [app_id=".*"] inhibit_idle fullscreen

# ╔═══════════════════════════════════════════════════╗
# ║                 STATUS BAR                        ║
# ╚═══════════════════════════════════════════════════╝

for_window [title="Volume"] floating enable, resize set 500 200
bar {
    bindsym button3 exec ~/.local/bin/omarchy-bar-menu
    position top
    height 26
    font pango:JetBrainsMono Nerd Font Mono 9
    status_command i3blocks
    pango_markup disabled
    strip_workspace_numbers no
    colors {
        background #1a1b26e6
        statusline #a9b1d6
        separator  #00000000
        focused_workspace  #7aa2f7 #7aa2f7 #1a1b26
        active_workspace   #414868 #414868 #a9b1d6
        inactive_workspace #1a1b2600 #1a1b2600 #414868
        urgent_workspace   #f7768e #f7768e #1a1b26
    }
}

# ╔═══════════════════════════════════════════════════╗
# ║                  AUTOSTART                        ║
# ╚═══════════════════════════════════════════════════╝

exec_always autotiling
exec mkfifo /run/user/1001/wob.sock && tail -f /run/user/1001/wob.sock | wob --anchor bottom --margin 40 --height 30 --width 400 --border-size 2 --bar-padding 2 --background-color "#1a1b26CC" --border-color "#7aa2f7" --bar-color "#7aa2f7"
exec mako
exec pipewire
exec wireplumber
exec udiskie --automount --notify &
exec_always gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
exec_always gsettings set org.gnome.desktop.interface color-scheme prefer-dark
exec_always gsettings set org.gnome.desktop.interface monospace-font-name "JetBrainsMono Nerd Font 10"
#exec swayidle -w timeout 300 'swaylock -f' timeout 600 'swaymsg output * dpms off' resume 'swaymsg output * dpms on' before-sleep 'swaylock -f' &
