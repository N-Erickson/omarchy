[menu]
command=~/.local/lib/i3blocks/menu
interval=once

[browser]
command=~/.local/lib/i3blocks/browser
interval=once

[wifi]
command=~/.local/lib/i3blocks/wifi
interval=10

[memory]
command=~/.local/lib/i3blocks/memory
interval=10

[volume]
command=~/.local/lib/i3blocks/volume
interval=10

[battery]
command=~/.local/lib/i3blocks/battery
interval=30

[theme]
command=~/.local/lib/i3blocks/theme
interval=once
signal=1

[date]
command=~/.local/lib/i3blocks/date
interval=60

[time]
command=~/.local/lib/i3blocks/time
interval=10

[power]
command=~/.local/lib/i3blocks/power
interval=once
